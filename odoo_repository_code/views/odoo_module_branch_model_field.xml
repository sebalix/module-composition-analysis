<odoo>

  <record id="odoo_module_branch_model_field_view_form" model="ir.ui.view">
    <field name="name">odoo.module.branch.model.field.form</field>
    <field name="model">odoo.module.branch.model.field</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="module_branch_model_id" />
              <field name="name" />
              <field name="field_type" />
              <field name="is_computed" />
              <field name="is_readonly" />
              <field name="is_stored" />
            </group>
            <group>
              <field name="param_string" />
              <field name="param_help" />
              <field name="param_required" />
              <field name="param_default" />
              <field name="param_readonly" />
              <field name="param_compute" />
              <field name="param_inverse" />
              <field name="param_search" />
              <field name="param_related" />
              <field name="param_store" />
              <field name="param_index" />
              <field name="param_copy" />
              <field name="param_ondelete" />
              <field name="param_auto_join" />
              <field name="param_comodel_name" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="odoo_module_branch_model_field_view_tree" model="ir.ui.view">
    <field name="name">odoo.module.branch.model.field.tree</field>
    <field name="model">odoo.module.branch.model.field</field>
    <field name="arch" type="xml">
      <tree decoration-muted="not active">
        <field name="odoo_version_id" optional="show" />
        <field name="module_branch_id" optional="show" />
        <field name="odoo_model_id" optional="show" />
        <field name="name" />
        <field name="param_string" optional="show" />
        <field name="field_type" optional="show" />
        <field name="repository_id" optional="hide" />
        <field name="param_required" optional="hide" />
        <field name="is_computed" optional="hide" />
        <field name="is_readonly" optional="hide" />
        <field name="is_stored" optional="hide" />
        <field name="global_dependency_level" optional="hide" />
        <field name="active" invisible="1" />
      </tree>
    </field>
  </record>

  <record id="odoo_module_branch_model_field_view_search" model="ir.ui.view">
    <field name="name">odoo.module.branch.model.field.search</field>
    <field name="model">odoo.module.branch.model.field</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="param_string" />
        <field name="odoo_model_id" />
        <field name="field_type" />
        <field name="module_branch_id" />
        <field name="odoo_version_id" />
        <field name="repository_id" />
        <field name="org_id" />
        <field name="param_help" />
        <filter
                    name="required"
                    string="Required"
                    domain="[('param_required', '=', True)]"
                />
        <filter
                    name="is_computed"
                    string="Computed"
                    domain="[('is_computed', '=', True)]"
                />
        <filter
                    name="is_readonly"
                    string="Readonly"
                    domain="[('is_readonly', '=', True)]"
                />
        <filter name="is_stored" string="Stored" domain="[('is_stored', '=', True)]" />
        <filter
                    name="not_stored"
                    string="Not Stored"
                    domain="[('is_stored', '=', False)]"
                />
        <filter name="inactive" string="Archived" domain="[('active', '=', True)]" />
        <group expand="0" string="Group By">
          <filter
                        name="group_by_odoo_model_id"
                        string="Model"
                        context="{'group_by': 'odoo_model_id'}"
                    />
          <filter
                        name="group_by_module_name"
                        string="Module"
                        context="{'group_by': 'module_name'}"
                    />
          <filter
                        name="group_by_odoo_version_id"
                        string="Odoo Version"
                        context="{'group_by': 'odoo_version_id'}"
                    />
          <filter
                        name="group_by_org_id"
                        string="Organization"
                        context="{'group_by': 'org_id'}"
                    />
          <filter
                        name="group_by_repository_id"
                        string="Repository"
                        context="{'group_by': 'repository_id'}"
                    />
        </group>
      </search>
    </field>
  </record>

  <record id="odoo_module_branch_model_field_action" model="ir.actions.act_window">
    <field name="name">Fields</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">odoo.module.branch.model.field</field>
    <field name="view_id" ref="odoo_module_branch_model_field_view_tree" />
    <field
            name="context"
        >{'search_default_group_by_odoo_version_id': 1, 'search_default_group_by_odoo_model_id': 2}</field>
  </record>

  <menuitem
        id="odoo_module_branch_model_field_menu"
        parent="code_odoo_repository_menu"
        action="odoo_module_branch_model_field_action"
        sequence="40"
    />

</odoo>
