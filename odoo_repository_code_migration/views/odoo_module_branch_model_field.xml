<odoo>
    <record id="odoo_module_branch_model_field_view_form" model="ir.ui.view">
        <field name="name">odoo.module.branch.model.field.form.inherit</field>
        <field name="model">odoo.module.branch.model.field</field>
        <field
            name="inherit_id"
            ref="odoo_repository_code.odoo_module_branch_model_field_view_form"
        />
        <field name="arch" type="xml">
            <field name="root_id" position="after">
                <field
                    name="next_odoo_version_field_id"
                    invisible="not next_odoo_version_field_id"
                />
                <field name="next_version_state" />
            </field>
        </field>
    </record>
</odoo>
